# splunk-curl-search profile — KEY=VALUE only, parsed (never sourced). Comments on their own line.
#
# Keep real site profiles OUT of the skill. Copy this file to one of (first match wins):
#   $SPLUNK_PROFILE_DIR/<name>.env
#   ${XDG_CONFIG_HOME:-~/.config}/splunk-curl-search/profiles/<name>.env
# and use it with -p <name>. Values here are overridden by SPLUNK_* env exports, which are
# overridden by SPLUNK_CRED_FILE. SPLUNK_URL may not differ between them.

# Splunk host (no scheme) and Splunk Web port.
SPLUNK_URL=splunk.example.com
SPLUNK_PORT=443
# splunkd management port (direct REST; used when reachable from this vantage).
SPLUNK_MGMT_PORT=8089

# Credential: op://<vault>/<item>/<field> (1Password CLI), or leave empty and point
# SPLUNK_CRED_FILE at a 0600 KEY=VALUE file holding SPLUNK_URL, SPLUNK_USER_NAME,
# SPLUNK_PASSWORD (and optionally SPLUNK_PORT, SPLUNK_TOKEN).
SPLUNK_USER_NAME=<user>
SPLUNK_PASSWORD=op://<vault>/<item>/password
# Optional Splunk auth token (bearer) — used only on the mgmt port; works for SAML users.
# SPLUNK_TOKEN=op://<vault>/<item>/token
# SPLUNK_CRED_FILE=/path/to/splunk-cred.env

# auto = detect front door (mgmt-basic | mgmt-token | web-local | blocked); or force one.
AUTH_MODE=auto
# prod requires SPLUNK_ALLOW_PROD=yes in the environment (operator's explicit demand).
ENV_CLASS=nonprod

# Raw (event) searches may only name these indexes; empty = any explicit non-wildcard index.
ALLOWED_INDEXES=main
DEFAULT_EARLIEST=-24h
# Longest raw-search window. tstats/metadata/rest are exempt.
MAX_WINDOW=7d
MAX_RESULTS=10000
MAX_TIME_S=120
# Raw search aborts if | tstats count over its indexes+window exceeds this.
MAX_SCAN_EVENTS=5000000

# How this site's host field encodes a short hostname (printf format), e.g. %s or %s.log
HOST_FORMAT=%s
# Seconds without events before an expected host is STALE.
STALE_AFTER=86400
# HTTP(S) proxy for reaching Splunk; unset = connect directly (http(s)_proxy ignored).
# SPLUNK_PROXY=http://proxy.example.com:3128
# CA bundle for TLS verification; unset = curl -k.
# CA_BUNDLE=/path/to/ca-bundle.pem
# Default output directory for result CSVs (else $TMPDIR/splunk-curl-search).
# REPORT_DIR=/path/to/reports

# Free-form site notes (front door, host-field convention, index meanings) go in
# comments here — the profile is the place for site facts, not the skill.
