#!/usr/bin/env bash
# Resolve the execution working tree, never infer it from the plan path. A plan
# can live in the main checkout while execution belongs to a linked worktree.
# Callers apply their optional -C DIR before invoking this helper through bash.
# Adapted from superpowers v7.0.2 (MIT).
# Usage: sdd-repo [--with-commit]
set -euo pipefail

with_commit=false
if [ "${1:-}" = "--with-commit" ]; then
  with_commit=true
  shift
fi

if [ $# -ne 0 ]; then
  echo "usage: sdd-repo [--with-commit]" >&2
  exit 2
fi

if root=$(git rev-parse --show-toplevel 2>/dev/null); then
  if [ "$with_commit" = false ] || git -C "$root" rev-parse --verify --quiet HEAD >/dev/null; then
    printf '%s\n' "$root"
    exit 0
  fi
  said=$(git -C "$root" rev-parse --verify HEAD 2>&1 >/dev/null) || true
else
  said=$(git rev-parse --show-toplevel 2>&1 >/dev/null) || true
fi

# Include git's actual error: this may be ownership or a missing binary rather
# than a new project. Never silently init a repo in an installed skill cache.
echo "SDD scripts must run from inside the git working tree you're executing in (current directory: $PWD). Commands using commit ranges also need at least one commit. If this is a new project, run 'git init' and make a first commit, then rerun." >&2
echo "git said: ${said%%$'\n'*}" >&2
exit 2
